#!/bin/bash

pprint (){
	cred='\033[0;31m'
	cgreen='\033[0;32m'
	cyellow='\033[0;33m'
	cblue='\033[0;34m'
	cpurple='\033[0;35m'
	eval "export color='$cpurple'"
	[ ! -z $2 ] && eval "export color=\"\$$2\""
    printf "$color $1"
}

color_reset(){ printf '\033[0;37m';}

yesnoprompt(){
	old_stty_cfg=$(stty -g)
	stty raw -echo ; answer=$(head -c 1)
	stty $old_stty_cfg
	echo "$answer" | grep -iq "^y"
}

update() {
	pprint "\n\nUpdating package list.. "
	sudo apt update 2>&1 | grep "can be upgraded" &>/dev/null
	if [ $? -eq 0 ]; then
		pprint "UPDATE AVAILABLE" "cgreen"
		pprint "\n\nDo you want to automatically upgrade (y/n)?"
		if yesnoprompt; then
			pprint "\n\nUpgrading packages.. "
			sudo apt upgrade -y &>/dev/null &&
			pprint "DONE!\n\n" "cgreen" || (pprint "FAIL.\n\n" "cred"; exit 1)
		else
			echo
		fi
	else
		pprint "ALREADY UP TO DATE\n\n" "cgreen"
	fi
}

packages(){
	pprint "Installing system dependencies (python3-pip, python3-venv, python3-full, ffmpeg, git, tmux)... "
	sudo apt-get update -y &>/dev/null
	sudo apt-get install -y python3-pip python3-venv python3-full ffmpeg git tmux &>/dev/null &&
	pprint "SUCCESS.\n\n" "cgreen" || (pprint "FAIL.\n\n" "cred"; exit 1)
}

venv_setup(){
	pprint "Setting up Python virtual environment (.venv)... "
	if [ ! -f ".venv/bin/python" ]; then
		rm -rf .venv
		python3 -m venv .venv &>>pypilog.txt
	fi
	if [ -f ".venv/bin/python" ]; then
		pprint "SUCCESS.\n\n" "cgreen"
	else
		pprint "FAIL.\n\n" "cred"
		exit 1
	fi
}

installation(){
	pprint "\nInstalling py-tgcalls 0.9.7 into .venv...\n"
	.venv/bin/python -c "import urllib.request, zipfile, io, sys; url='https://files.pythonhosted.org/packages/13/2d/b6c556e815f185075eeb747b1f89e8c6198b442010eeecc7e99ccc9d17d3/py_tgcalls-0.9.7-cp311-cp311-manylinux2014_x86_64.whl'; data = urllib.request.urlopen(url).read(); z = zipfile.ZipFile(io.BytesIO(data)); sp = [p for p in sys.path if 'site-packages' in p][0]; z.extractall(sp)" &>>pypilog.txt

	pprint "\nUpgrading pip and installing Python dependencies into .venv...\n"
	.venv/bin/python -m pip install -U pip &>>pypilog.txt
	.venv/bin/python -m pip install -U -r requirements.txt &>>pypilog.txt
	.venv/bin/python -m pip install tgcrypto &>>pypilog.txt || true

	if .venv/bin/python -c "import MusicSp" &>/dev/null; then
		pprint "DONE.\n" "cgreen"
		return 0
	else
		pprint "FAIL.\n" "cred"
		pprint "Check pypilog.txt for errors.\n" "cred"
		exit 1
	fi
}

clear
pprint "Welcome to MusicSp Setup Installer\n\n"
pprint "If you see any error during Installation Process, Please refer to: pypilog.txt"
sleep 1
pprint "\n\nScript needs sudo privileges in order to update & install packages.\n"
sudo test

update
packages
venv_setup
installation
pprint "\n\nMusicSp Installation Completed !" "cgreen"
sleep 1
clear

if [ ! -f .env ]; then
	pprint "\nEnter Your Values Below\n\n\n"
	pprint "API ID: "; color_reset; read api_id
	pprint "\nAPI HASH: "; color_reset; read api_hash
	pprint "\nBOT TOKEN: "; color_reset; read bot_token
	pprint "\nOWNER ID:"; color_reset; read ownid
	pprint "\nMONGO DB URI: "; color_reset; read mongo_db
	pprint "\nLOG GROUP ID: "; color_reset; read logger
	pprint "\nSTRING SESSION: "; color_reset; read string_session

	pprint "\n\nProcessing your vars, wait a while !" "cgreen"

	echo """API_ID = $api_id
API_HASH = $api_hash
BOT_TOKEN = $bot_token
MONGO_DB_URI = $mongo_db
LOG_GROUP_ID = $logger
STRING_SESSION = $string_session
OWNER_ID = $ownid""" > .env
	clear
	pprint "\n\nThanks for using MusicSp installer, your vars have been saved successfully ! \nIf you wanna add more variables add them in your env by : vi .env"
else
	pprint "\n.env file already exists. Skipping variable prompts."
fi

pprint "\n\nNow you can start the bot by : bash start\n\n"
